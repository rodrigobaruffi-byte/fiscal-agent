# Modelo do arquivo .env. Este vai para o Git; o .env de verdade, NÃO (está no .gitignore).
# Copie para .env (na mesma pasta) e preencha só o que for usar:  copy .env.example .env
# Os testes não leem nada daqui: rodam com clientes falsos.

# Qual LLM faz a extração: anthropic | gemini | ollama
PROVEDOR=anthropic

# Anthropic (pago; o Haiku é o mais barato). Chave em platform.claude.com → API Keys.
ANTHROPIC_API_KEY=
ANTHROPIC_MODELO=claude-haiku-5-5

# Gemini (tem cota gratuita). Chave em aistudio.google.com → Get API key.
# O nome do modelo está na lista de modelos do AI Studio (um "flash" é o mais barato).
GEMINI_API_KEY=
GEMINI_MODELO=

# Ollama (local, de graça, sem chave). O modelo precisa estar baixado: ollama pull <nome>; ollama list mostra.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=

# 1 = modo demonstração: a API finge ser o modelo, sem chave e sem custo (vale por cima do PROVEDOR).
EXTRACAO_DEMO=
